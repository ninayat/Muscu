# ---------- Database ----------
# Postgres connection string — Vercel Postgres, Supabase, Neon, Railway, or local docker
DATABASE_URL="postgresql://ironfeed:ironfeed@localhost:5432/ironfeed?schema=public"

# ---------- NextAuth ----------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email magic link (SMTP). For dev, Mailtrap/Resend/Ethereal all work.
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="IronFeed <noreply@ironfeed.app>"

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=""

# ---------- Public ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- Admin ----------
# Comma-separated list of admin emails that can access /admin
ADMIN_EMAILS=""
